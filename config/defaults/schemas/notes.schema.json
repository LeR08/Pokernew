{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lps://schemas/notes",
  "title": "schema.notes.title",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule"
  ],
  "properties": {
    "rule": {
      "title": "schema.notes.rule",
      "type": "object",
      "x-widget": "hidden",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "when"
        ],
        "properties": {
          "text": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fr",
                  "en"
                ],
                "properties": {
                  "fr": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "min_sample": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
