{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lps://schemas/payouts",
  "title": "schema.payouts.title",
  "description": "schema.payouts.description",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "unit", "places"],
  "properties": {
    "name": { "title": "schema.payouts.name", "type": "string", "minLength": 1 },
    "players": { "title": "schema.payouts.players", "type": "integer", "minimum": 2 },
    "unit": { "title": "schema.payouts.unit", "type": "string", "enum": ["money", "percent"], "default": "money" },
    "prize_pool": { "title": "schema.payouts.prize_pool", "type": "number", "minimum": 0 },
    "places": {
      "title": "schema.payouts.places",
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0 }
    }
  }
}
